# Copy to deploy/deploy.env (gitignored) — sourced automatically by the
# deploy scripts.
#
#     cp deploy/deploy.env.example deploy/deploy.env

# Required: where both images are pushed and pulled from.
DOCKERHUB_USER=your-dockerhub-username

# ── Deploying to a host you already have (the free option) ─────────────
# An Oracle Cloud Always Free VM, or anything else with ssh and a public IP.
# `task deploy:remote` reads these; the host stays up, costs nothing, and
# keeps its data between deploys.
#REMOTE_HOST=your.vm.public.ip
#KEY_FILE=~/.ssh/oracle-oss-dashboard.key

# Which architectures to build. Both by default, which is what you want if
# you are unsure — Oracle's free shape is arm64, most x86 hosts are amd64.
#TARGET_ARCH=linux/arm64,linux/amd64

# Optional, and what turns on HTTPS and OAuth.
#
# Without these the stack comes up at http://<ip>:30080 with a new address
# every deploy, which works fine for email-and-password sign-in but cannot
# support OAuth — GitHub and Google both need a callback URL that doesn't
# move.
#
# With them, deploy/up.sh points the name at the new instance on every
# deploy and Caddy obtains a real Let's Encrypt certificate, so the app is
# reachable at https://<subdomain>.duckdns.org and stays there.
#
# Get both free at https://www.duckdns.org (sign in with GitHub, pick a
# subdomain, copy the token shown at the top of the page).
#DUCKDNS_SUBDOMAIN=your-subdomain
#DUCKDNS_TOKEN=

# Optional. Let's Encrypt uses it only to warn you before a certificate
# expires — which Caddy renews automatically anyway.
#ACME_EMAIL=you@example.com
