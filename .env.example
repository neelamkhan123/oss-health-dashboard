POSTGRES_USER=oss_dashboard
POSTGRES_PASSWORD=localdevpassword
POSTGRES_DB=oss_dashboard
DATABASE_URL=postgresql://oss_dashboard:localdevpassword@postgres:5432/oss_dashboard
REDIS_URL=redis://redis:6379/0

# A GitHub Personal Access Token with public_repo scope — Settings >
# Developer settings > Personal access tokens > Tokens (classic).
# Without a real one, the sync job will fail with 401s; the app still
# runs, it just has nothing to show until a sync succeeds.
GITHUB_TOKEN=ghp_replace_with_a_real_token

# Any random string — generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_generated_secret
