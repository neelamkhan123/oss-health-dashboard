POSTGRES_USER=oss_dashboard
POSTGRES_PASSWORD=localdevpassword
POSTGRES_DB=oss_dashboard
DATABASE_URL=postgresql://oss_dashboard:localdevpassword@postgres:5432/oss_dashboard
REDIS_URL=redis://redis:6379/0

# A GitHub Personal Access Token with public_repo scope — Settings >
# Developer settings > Personal access tokens > Tokens (classic).
# Without a real one, the sync job will fail with 401s; the app still
# runs, it just has nothing to show until a sync succeeds.
GITHUB_TOKEN=ghp_replace_with_a_real_token

# --- OAuth providers (Parts 01 and 02) ---
GITHUB_CLIENT_ID=Ov23li...
GITHUB_CLIENT_SECRET=...
GOOGLE_CLIENT_ID=1234567890-....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Where the browser gets sent back to once a provider round trip finishes,
# and the origin the backend builds its own callback URLs from. These have
# to match the URLs you registered with GitHub and Google exactly.
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# Cookie behaviour. Both of these change in production — see the note below.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax