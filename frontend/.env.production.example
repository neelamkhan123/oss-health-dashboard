# Copy to .env.production before building for deployment:
#     cp .env.production.example .env.production
#
# Relative, not absolute: the frontend and API are served from one
# CloudFront distribution (S3 for /*, EC2 for /api/*), so the API is
# same-origin and the session cookie stays first-party. See DEPLOY_GUIDE.md 18.0.
VITE_API_URL=/api
